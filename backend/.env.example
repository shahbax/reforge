# Reforge backend configuration. Copy to `.env` and fill in.
# Everything below has a safe development default — the app runs with an EMPTY
# .env using the mock AI provider, dev-stub ingestion, and an in-memory store.

# --- App ---
ENVIRONMENT=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- AI provider ---
# mock  => no keys needed, deterministic fixtures (default)
# claude => real Anthropic calls (requires ANTHROPIC_API_KEY)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODEL_STRONG=claude-sonnet-5
MODEL_CHEAP=claude-haiku-4-5-20251001
EMBEDDING_MODEL=text-embedding-3-small

# --- Data ---
# Empty DATABASE_URL => in-memory dev store (data lost on restart).
# For production, use your Supabase Postgres URI:
#   Project Settings > Database > Connection string > URI (Session pooler)
#   postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Empty REDIS_URL => jobs run in an in-process thread pool (no external queue).
REDIS_URL=

# --- Supabase (auth) ---
# Empty SUPABASE_JWT_SECRET => dev auth: requests are attributed to a single
# dev user (optionally overridden with the `X-Dev-User` header). Set the secret
# to enforce real Supabase JWT verification.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- Limits / cost control ---
MAX_VIDEO_DURATION_SECONDS=3600
MAX_UPLOAD_MB=500
FREE_PLAN_CREDITS=2

# --- Jobs ---
# true => run pipeline jobs synchronously within the request (used by tests).
JOBS_INLINE=false
